# Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/cache

# Testing & Playwright reports
/coverage
/playwright-report/
/test-results/
/scripts/.tmp*

# Next.js & Vercel build output
/.next/
/out/
/.vercel

# Production build artifacts
/build
/dist

# Debug & local logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment files - NEVER commit credentials or secret keys
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# Allow env example template
!.env.example

# Supabase CLI temporary linkage/cache state
supabase/.temp/
.supabase/

# Local private customer or driving licence documents
/driving-licences/

# OS generated files
.DS_Store
Thumbs.db

# TypeScript cache
*.tsbuildinfo
next-env.d.ts
