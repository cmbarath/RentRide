# ==============================================================================
# RentRide – Production Environment Configuration
# Region: Tamil Nadu, India (Asia/Kolkata timezone, INR Currency)
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL & Auth Credentials
# ------------------------------------------------------------------------------
# Found in Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# ------------------------------------------------------------------------------
# 2. Razorpay Payment Gateway (Indian Rupees INR)
# ------------------------------------------------------------------------------
# Found in Razorpay Dashboard -> Settings -> API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YourTestKeyId1234
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ------------------------------------------------------------------------------
# 3. Meta WhatsApp Business Cloud API
# ------------------------------------------------------------------------------
# Found in Meta Developer Dashboard -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID=109876543210987
WHATSAPP_BUSINESS_ACCOUNT_ID=123456789012345
WHATSAPP_ACCESS_TOKEN=EAAB...your_meta_system_user_access_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=rentride_tn_webhook_verify_token_2026

# Staff mobile number receiving instant booking & KYC notifications
ADMIN_WHATSAPP_PHONE=+919840098920

# ------------------------------------------------------------------------------
# 4. Regional Tax & Business Defaults
# ------------------------------------------------------------------------------
NEXT_PUBLIC_DEFAULT_GST_RATE=18
NEXT_PUBLIC_COMPANY_GSTIN=33AABCR8721K1ZM
NEXT_PUBLIC_SUPPORT_PHONE=+91 800-RENTRIDE
