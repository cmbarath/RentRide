# ==============================================================================
# RentRide – Environment Variables Template (Placeholders Only)
# Region: Tamil Nadu, India (Asia/Kolkata timezone, INR Currency)
# Copy this file to .env.local and fill in values locally. NEVER commit .env.local.
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 1. Supabase Project & Authentication Keys (Required)
# ------------------------------------------------------------------------------
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Server-only privileged keys (NEVER prefix with NEXT_PUBLIC_ or expose to client)
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# ------------------------------------------------------------------------------
# 2. Regional Tax & Business Display Defaults
# ------------------------------------------------------------------------------
NEXT_PUBLIC_DEFAULT_GST_RATE=18
NEXT_PUBLIC_COMPANY_GSTIN=your_gstin_number_here
NEXT_PUBLIC_SUPPORT_PHONE=+91-800-000-0000

# ------------------------------------------------------------------------------
# 3. Local QA Administrator Credentials (Optional — Local Only)
# ------------------------------------------------------------------------------
# Customer QA accounts are provisioned dynamically per test run and auto-deleted.
QA_ADMIN_EMAIL=admin@example.com
QA_ADMIN_PASSWORD=replace_with_local_test_admin_password
